# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Large Audio Datasets and Output Audio (Raw, Processed Stems, and Master WAVs stay local on Disco T7)
data/raw/*
!data/raw/.gitkeep
data/stems/*
!data/stems/.gitkeep
outputs/**/*.wav
outputs/**/*.mp3
outputs/**/*.flac
outputs/audio/*
!outputs/audio/.gitkeep

# IDEs
.idea/
.vscode/
*.swp
*.swo
